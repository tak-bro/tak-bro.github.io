{
  "name": "tak-bro-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "react-router dev --port 5175",
    "build": "react-router build --mode prod && node scripts/write-404.mjs",
    "typecheck": "react-router typegen --mode prod && tsc --noEmit",
    "test": "vitest run",
    "check:links": "node scripts/check-docs-links.mjs",
    "check:required": "node scripts/check-required-files.mjs",
    "check:sensitive": "node scripts/check-sensitive.mjs",
    "check": "pnpm check:sensitive && pnpm typecheck && pnpm test && pnpm build && pnpm check:links && pnpm check:required && echo 'check: ok'"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.1",
    "isbot": "^5.1.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "pretendard": "^1.3.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.19.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.6",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2",
    "vite": "8.2.1",
    "vitest": "^4.0.0"
  }
}
